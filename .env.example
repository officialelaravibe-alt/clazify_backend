# Copy to .env for local runs. On Render, set these under Environment.
# NEVER commit real values.

# PostgreSQL (Supabase) connection string
DATABASE_URL=
# Optional but recommended: Supabase CA certificate (PEM). Turns on full TLS checking.
DATABASE_CA_CERT=

# Firebase service account JSON (one line) for push notifications
FIREBASE_SERVICE_ACCOUNT=

# --- Sign-in (no shared secrets; everyone uses a Google work account) ---
# OAuth client IDs (public identifiers, not secrets), comma separated:
#   1) "Web client" of the Firebase project (used by the Clazify Android app)
#   2) "Desktop app" client (used by LAS)
GOOGLE_CLIENT_IDS=
# Only these email domains can sign in
ALLOWED_EMAIL_DOMAINS=codequotient.com,cqst.in
# Optional. Empty = the first person who signs in from LAS becomes the manager.
MANAGER_EMAILS=

# Optional
APP_TIMEZONE=Asia/Kolkata
NVIDIA_API_KEY=
NVIDIA_MODEL=meta/llama-4-maverick-17b-128e-instruct
GOOGLE_DRIVE_API_KEY=
GOOGLE_DRIVE_FOLDER_ID=
